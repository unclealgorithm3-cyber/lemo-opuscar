[
  {"id":"n1","t":0.2,"text":"रंगीला बाज़ार में आपका स्वागत है!","voice":"hf_alpha","speed":1.05,"lang":"hi"},
  {"id":"n2","t":4.2,"text":"गोल्डन एप्पल आंटी साड़ी लेने आईं।","voice":"hf_alpha","speed":1.05,"lang":"hi"},
  {"id":"a1","t":8.2,"text":"वाह! ये लाल साड़ी तो कमाल है।","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"a2","t":12.2,"text":"भैया, इसकी कीमत कितनी है?","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"s1","t":16.2,"text":"मैडम, इसकी कीमत पाँच हज़ार रुपये है।","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"a3","t":20.2,"text":"पाँच हज़ार रुपये?! इतना महँगा?","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"a4","t":24.2,"text":"कुछ कम कर दीजिए ना!","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"s2","t":28.2,"text":"दाम तो यही है, मैडम।","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"a5","t":32.2,"text":"इतना कौन देगा? आधा कर दीजिए!","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"n3","t":36.2,"text":"आंटी की छूट अब घटने लगी!","voice":"hf_alpha","speed":1.05,"lang":"hi"},
  {"id":"s3","t":40.2,"text":"ऐसे बात करेंगी तो छूट भी घटेगी!","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"a6","t":44.2,"text":"अरे! ये कैसा हिसाब है?","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"n4","t":48.2,"text":"तभी आए ब्लू स्ट्रॉबेरी अंकल।","voice":"hf_alpha","speed":1.05,"lang":"hi"},
  {"id":"u1","t":52.2,"text":"नमस्ते भैया, ये साड़ी कितने की है?","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"s4","t":56.2,"text":"आपके लिए अच्छी छूट है, अंकल।","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"a7","t":60.2,"text":"अरे! इन्हें इतनी छूट कैसे मिल गई?","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"a8","t":64.2,"text":"मुझे भी उतनी ही छूट चाहिए!","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"s5","t":68.2,"text":"पहले प्यार से बात कीजिए, मैडम।","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"a9","t":72.2,"text":"मैं ऐसे ही बात करती हूँ!","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"s6","t":76.2,"text":"अब सिर्फ़ पाँच प्रतिशत छूट मिलेगी!","voice":"hm_omega","speed":1.05,"lang":"hi"},
  {"id":"a10","t":80.2,"text":"क्या? कीमत पाँच हज़ार से दस हज़ार हो गई?","voice":"hf_beta","speed":1.05,"lang":"hi"},
  {"id":"a11","t":84.2,"text":"अरे! ये तो उल्टा पड़ गया!","voice":"hf_beta","speed":1.05,"lang":"hi"}
]
